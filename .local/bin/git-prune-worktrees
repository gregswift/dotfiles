#!/bin/sh
#
# git-prune-worktrees -- remove worktrees whose branch is merged and gone.
#
# A worktree is cleaned up only when both are true:
#   * its branch no longer exists on origin (it was pushed once, and is gone now)
#   * there is evidence the branch was merged into the default branch
#
# Remote gone but no merge evidence is the dangerous case, so it is never
# deleted: it goes to stderr for manual review.
#
# Dry run by default. Pass --yes to actually delete anything.

set -eu

ASSUME_YES=0
PROG=$(basename "$0")

usage() {
    cat <<EOF
Usage: git prune-worktrees [-y|--yes]

Fetches with --prune, then for each worktree:

  remote branch gone + merged      -> remove worktree, delete local branch
  remote branch gone + no evidence -> warning on stderr, left alone
  remote branch still exists       -> skipped
  never pushed                     -> skipped

Merge evidence, in order: a merged pull request via gh; the branch being an
ancestor of the default branch; the branch tree already present in the default
branch (catches squash merges).

Options:
  -y, --yes    Actually remove worktrees and delete branches.
  -h, --help   This text.

Exit status is 1 if any branch needs manual review.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)  ASSUME_YES=1 ;;
        -h|--help) usage; exit 0 ;;
        *)         printf '%s: unknown option: %s\n' "$PROG" "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

warn() { printf '⚠️  %s\n' "$*" >&2; }
die()  { printf '❌ %s\n' "$*" >&2; exit 1; }

command -v git >/dev/null 2>&1 || die "git not found in PATH"
git rev-parse --git-dir >/dev/null 2>&1 || die "not inside a git repository"

HAVE_GH=0
REPO=""
if command -v gh >/dev/null 2>&1; then
    # Resolve the repo once so gh never has to be run from a worktree, which
    # may have had its directory deleted out from under git.
    REPO=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || REPO=""
    if [ -n "$REPO" ]; then
        HAVE_GH=1
    else
        warn "gh cannot resolve this repository; falling back to local merge detection only"
    fi
else
    warn "gh not found; falling back to local merge detection only"
fi

default_branch() {
    ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || ref=""
    if [ -z "$ref" ]; then
        git remote set-head origin --auto >/dev/null 2>&1 || true
        ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || ref=""
    fi
    [ -n "$ref" ] || die "cannot resolve origin/HEAD; run: git remote set-head origin --auto"
    printf '%s\n' "${ref#origin/}"
}

# Emit "<branch-or-dash><TAB><path>" per non-bare worktree. Dash means detached.
list_worktrees() {
    git worktree list --porcelain | awk '
        /^worktree /  { path = substr($0, 10); branch = ""; bare = 0; det = 0; next }
        /^bare$/      { bare = 1; next }
        /^detached$/  { det = 1; next }
        /^branch /    { branch = substr($0, 8); sub(/^refs\/heads\//, "", branch); next }
        /^$/          { if (path != "" && !bare) printf "%s\t%s\n", (det ? "-" : branch), path
                        path = "" }
    '
}

# Sets REASON and returns 0 when the branch looks merged into $DEFAULT.
REASON=""
is_merged() {
    _branch=$1
    REASON=""

    if [ "$HAVE_GH" -eq 1 ]; then
        _pr=$(gh pr list -R "$REPO" --head "$_branch" --state merged \
                --json number --jq '.[0].number // empty' 2>/dev/null) || _pr=""
        if [ -n "$_pr" ]; then
            REASON="merged PR #$_pr"
            return 0
        fi
    fi

    if git merge-base --is-ancestor "$_branch" "origin/$DEFAULT" 2>/dev/null; then
        REASON="already an ancestor of origin/$DEFAULT"
        return 0
    fi

    # Squash-merge detection: build a throwaway commit carrying the branch tree
    # on top of the fork point. If its patch is already upstream, the branch
    # content landed even though no commit of it did.
    _base=$(git merge-base "origin/$DEFAULT" "$_branch" 2>/dev/null) || return 1
    _tree=$(git rev-parse "$_branch^{tree}" 2>/dev/null) || return 1
    _probe=$(git commit-tree "$_tree" -p "$_base" -m "prune-worktrees probe" 2>/dev/null) || return 1
    if git cherry "origin/$DEFAULT" "$_probe" 2>/dev/null | grep -q '^-'; then
        REASON="tree already in origin/$DEFAULT (squash-merged)"
        return 0
    fi

    return 1
}

printf '📥 Fetching from origin...\n'
git fetch --all --prune

DEFAULT=$(default_branch)
MAIN_WT=$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10); exit}')
CWD=$(pwd -P)
TAB=$(printf '\t')

WORK=$(mktemp) || die "cannot create temp file"
FLAGGED=$(mktemp) || die "cannot create temp file"
trap 'rm -f "$WORK" "$FLAGGED"' EXIT INT TERM
list_worktrees >"$WORK"

N_TOTAL=0; N_REMOVED=0; N_LIVE=0; N_LOCAL=0; N_DIRTY=0; N_UNMERGED=0; N_SKIPPED=0

while IFS="$TAB" read -r BRANCH DIR; do
    [ -n "${DIR:-}" ] || continue
    N_TOTAL=$((N_TOTAL + 1))

    if [ "$BRANCH" = "-" ] || [ "$BRANCH" = "$DEFAULT" ]; then
        N_SKIPPED=$((N_SKIPPED + 1))
        continue
    fi

    if [ "$DIR" = "$MAIN_WT" ]; then
        printf '⏭️  %s (%s): main worktree, skipping\n' "$DIR" "$BRANCH"
        N_SKIPPED=$((N_SKIPPED + 1))
        continue
    fi

    case "$CWD" in
        "$DIR"|"$DIR"/*)
            warn "$DIR ($BRANCH): you are standing in this worktree, skipping"
            echo x >>"$FLAGGED"
            N_SKIPPED=$((N_SKIPPED + 1))
            continue
            ;;
    esac

    # Still on origin -> the branch is live, nothing to do.
    if git rev-parse --verify --quiet "refs/remotes/origin/$BRANCH" >/dev/null; then
        N_LIVE=$((N_LIVE + 1))
        continue
    fi

    # branch.<name>.remote survives the remote branch being pruned, so it is the
    # signal that this branch was pushed at some point.
    if [ -z "$(git config --get "branch.$BRANCH.remote" 2>/dev/null || true)" ]; then
        N_LOCAL=$((N_LOCAL + 1))
        continue
    fi

    # The directory may already be gone (git calls such a worktree "prunable");
    # there is then nothing to be dirty and nothing to remove, only admin data.
    MISSING=0
    if [ ! -d "$DIR" ]; then
        MISSING=1
    else
        STATUS=$(git -C "$DIR" status --porcelain)
        if [ -n "$STATUS" ]; then
            COUNT=$(printf '%s\n' "$STATUS" | wc -l | tr -d ' ')
            if printf '%s\n' "$STATUS" | grep -qv '^??'; then
                KIND="modified tracked files"
            else
                KIND="untracked files"
            fi
            SAMPLE=$(printf '%s\n' "$STATUS" | head -3 | sed 's/^...//' | tr '\n' ' ')
            warn "$DIR ($BRANCH): remote gone but worktree has $COUNT $KIND ($SAMPLE...), skipping"
            echo x >>"$FLAGGED"
            N_DIRTY=$((N_DIRTY + 1))
            continue
        fi
    fi

    if ! is_merged "$BRANCH"; then
        warn "$DIR ($BRANCH): remote branch gone with no sign it was merged, review by hand"
        echo x >>"$FLAGGED"
        N_UNMERGED=$((N_UNMERGED + 1))
        continue
    fi

    if [ "$MISSING" -eq 1 ]; then
        VERB="prune stale worktree record for"
    else
        VERB="remove"
    fi

    if [ "$ASSUME_YES" -eq 0 ]; then
        printf '🧹 would %s %s and delete branch %s (%s)\n' "$VERB" "$DIR" "$BRANCH" "$REASON"
        N_REMOVED=$((N_REMOVED + 1))
        continue
    fi

    printf '🧹 %s %s, deleting branch %s (%s)\n' "$VERB" "$DIR" "$BRANCH" "$REASON"
    if [ "$MISSING" -eq 1 ]; then
        git worktree prune
    elif ! git worktree remove "$DIR"; then
        warn "$DIR ($BRANCH): worktree remove failed, branch left alone"
        echo x >>"$FLAGGED"
        continue
    fi
    if ! git branch -D "$BRANCH"; then
        warn "$BRANCH: worktree removed but branch delete failed"
        echo x >>"$FLAGGED"
    fi
    N_REMOVED=$((N_REMOVED + 1))
done <"$WORK"

if [ "$ASSUME_YES" -eq 0 ]; then
    REMOVED_LABEL="to remove"
else
    REMOVED_LABEL="removed"
fi

SUMMARY=""
add_summary() { [ "$1" -gt 0 ] && SUMMARY="$SUMMARY, $1 $2"; return 0; }
add_summary "$N_REMOVED"  "$REMOVED_LABEL"
add_summary "$N_UNMERGED" "unmerged"
add_summary "$N_DIRTY"    "dirty"
add_summary "$N_LIVE"     "live on origin"
add_summary "$N_LOCAL"    "never pushed"
add_summary "$N_SKIPPED"  "skipped"
[ -n "$SUMMARY" ] || SUMMARY=", nothing to do"
printf '\n%s worktrees: %s\n' "$N_TOTAL" "${SUMMARY#, }"

if [ "$ASSUME_YES" -eq 0 ] && [ "$N_REMOVED" -gt 0 ]; then
    printf '✅ Dry run. Re-run with --yes to apply.\n'
fi

if [ -s "$FLAGGED" ]; then
    printf '⚠️  %s worktree(s) need manual review, see above.\n' "$(wc -l <"$FLAGGED" | tr -d ' ')" >&2
    exit 1
fi
