{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "text": "#000000",
    "black": "#000000",
    "light-text": "#e0def4",
    "tooltip-text": "#000000",
    "error": "#e91e63",
    "success": "#00897b",
    "git-bg": "#5682d8",
    "git-dirty": "#f3ae35",
    "git-ahead": "#49416d",
    "git-behind": "#7a306c",
    "git-diverged": "#d81e5b",
    "dev-bg": "#66ed5c",
    "staging-bg": "#ea8927",
    "prod-bg": "#ef404c"
  },
  "profiles": {
    "defaults": {
      "font": {
        "face": "MesloLGM Nerd Font"
      }
    }
  },
  "accent_color": "32",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "background": "p:success",
          "background_templates": [
            "{{ if ne .Code 0 }}p:error{{ end }}"
          ],
          "foreground": "p:text",
          "options": {
            "folder_icon": "…",
            "folder_separator_icon": "/",
            "style": "agnoster_short",
            "max_depth": 3
          },
          "style": "diamond",
          "template": " {{ .Path }} ",
          "trailing_diamond": "",
          "type": "path",
          "leading_diamond": ""
        },
        {
          "background": "p:git-bg",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:git-dirty{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:git-diverged{{ end }}",
            "{{ if gt .Ahead 0 }}p:git-ahead{{ end }}",
            "{{ if gt .Behind 0 }}p:git-behind{{ end }}"
          ],
          "foreground": "p:text",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:text{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:light-text{{ end }}"
          ],
          "leading_diamond": "",
          "options": {
            "branch_icon": "",
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "mapped_branches": {
              "feat/*": "🚀 ",
              "bug/*": "🐛 "
            }
          },
          "style": "diamond",
          "template": " {{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ end }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Staging.Changed) (.Working.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} ",
          "trailing_diamond": "",
          "type": "git"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "background": "accent",
          "background_templates": [
            "{{ if .OutputStyle }}{{ if ne .OutputStyle.Name \"Concise STE\" }}p:error{{ end }}{{ else }}p:error{{ end }}"
          ],
          "foreground": "p:light-text",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{ .Model.DisplayName }} ",
          "trailing_diamond": "",
          "type": "claude"
        },
        {
          "background": "p:success",
          "background_templates": [
            "{{ if ge .TokenUsagePercent 90 }}p:prod-bg{{ end }}",
            "{{ if ge .TokenUsagePercent 75 }}p:error{{ end }}",
            "{{ if ge .TokenUsagePercent 50 }}p:git-dirty{{ end }}"
          ],
          "foreground": "p:text",
          "leading_diamond": "",
          "style": "diamond",
          "template": "  {{ .TokenUsagePercent.GaugeUsed }} ",
          "trailing_diamond": "",
          "type": "claude"
        },
        {
          "background": "p:success",
          "background_templates": [
            "{{ if ge .FiveHourUsage 90 }}p:prod-bg{{ end }}",
            "{{ if ge .FiveHourUsage 75 }}p:error{{ end }}",
            "{{ if ge .FiveHourUsage 50 }}p:git-dirty{{ end }}"
          ],
          "foreground": "p:text",
          "leading_diamond": "",
          "style": "diamond",
          "template": "  {{ .FiveHourGauge }} ",
          "trailing_diamond": "",
          "type": "claude"
        }
      ]
    }
  ],
  "version": 4
}
