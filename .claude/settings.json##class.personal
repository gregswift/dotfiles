{
  "env": {},
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(git add -A:*)",
      "Bash(git add -a:*)",
      "Bash(git add --all:*)",
      "Bash(gh api *DELETE*)"
    ],
    "ask": [
      "Bash(kubectl:*)",
      "Bash(az:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(grpcurl:*)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh workflow run:*)"
    ],
    "blockReadsOutsideWorkingDirectories": true
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/writing-rules.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/writing-rules-report.py"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "COLUMNS=$((${COLUMNS:-120}-16)) oh-my-posh claude --config ~/.claude-prompt.json",
    "padding": 0
  },
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "mattpocock-skills@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    }
  },
  "outputStyle": "Concise STE",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "*.github.com",
        "github.com",
        "*.golang.org",
        "registry.npmjs.org"
      ],
      "allowUnixSockets": [
        "/Users/gregswift/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/var/folders"
      ],
      "allowRead": [
        "~/.ssh/known_hosts",
        "~/.local/bin",
        "~/.config/gh"
      ]
    },
    "excludedCommands": [
      "gh pr *",
      "gh issue *",
      "gh run *",
      "gh repo *",
      "gh search *",
      "gh auth status",
      "git -C * commit*",
      "git -C * fetch*",
      "git -C * ls-remote*",
      "git -C * new-worktree*",
      "git -C * pull*",
      "git -C * push*",
      "git -C * refresh*",
      "git -C * search*",
      "git commit *",
      "git fetch *",
      "git ls-remote *",
      "git new-worktree *",
      "git pull *",
      "git push *",
      "git refresh *",
      "git search *",
      "podman *",
      "make *"
    ]
  },
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "pluginConfigs": {},
  "tui": "fullscreen",
  "editorMode": "normal",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
